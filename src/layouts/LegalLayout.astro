---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  updated: string;
}
const { title, description, updated } = Astro.props;
---
<BaseLayout title={title} description={description} minimal>
  <article class="container-site max-w-[760px] py-14 md:py-20">
    <p class="eyebrow">Informação legal</p>
    <h1 class="mt-2 text-[clamp(2rem,4vw,2.75rem)]">{title}</h1>
    <p class="mt-3 text-[0.92rem] text-muted">Última atualização: {updated}</p>
    <div class="legal-body mt-10 grid gap-5">
      <slot />
    </div>
  </article>
</BaseLayout>

<style is:global>
  .legal-body h2 { font-size: 1.35rem; margin-top: 1.25rem; }
  .legal-body ul { list-style: disc; padding-left: 1.25rem; display: grid; gap: 0.4rem; }
  .legal-body a { color: var(--color-brand); font-weight: 600; }
</style>
