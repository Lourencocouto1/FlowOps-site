---
import SectionHead from '../ui/SectionHead.astro';
import ServicePreview from '../mockups/ServicePreview.astro';
import { getSection, getOrdered } from '../../lib/site';

const head = await getSection('services');
const items = await getOrdered('services');
---
<section class="section bg-soft" id="servicos" aria-labelledby="servicos-title">
  <div class="container-site">
    <SectionHead id="servicos-title" label={head.label} title={head.title} lead={head.lead} />
    <ul class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {items.map(({ data }) => (
        <li class="sv-card lift grid content-start gap-2.5 overflow-hidden rounded-[14px] border border-line bg-white p-6">
          <ServicePreview kind={data.preview} />
          <h3 class="text-[1.15rem]">{data.title}</h3>
          <p class="text-muted">{data.text}</p>
          <p class="rounded-lg bg-soft px-3 py-2 text-[0.88rem]"><span class="font-semibold text-brand-strong">Exemplo:</span> {data.example}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
