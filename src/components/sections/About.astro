---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHead from '../ui/SectionHead.astro';
import BrandF from '../ui/BrandF.astro';
import { getSection, getOrdered } from '../../lib/site';

const head = await getSection('about');
const founders = await getOrdered('founders');
// Fotos em src/assets/team/ (otimizadas para AVIF/WebP no build).
const photos = import.meta.glob<{ default: ImageMetadata }>('../../assets/team/*.{jpg,jpeg,png,webp}', { eager: true });
const photoFor = (file: string) => (file ? photos[`../../assets/team/${file}`]?.default : undefined);
---
<section class="section relative overflow-hidden" id="sobre" aria-labelledby="sobre-title">
  <BrandF class="wm-f text-brand opacity-[0.06]" />
  <div class="container-site relative z-[1]">
    <SectionHead id="sobre-title" label={head.label} title={head.title} lead={head.lead} />
    <ul class="grid gap-4 md:grid-cols-2">
      {founders.map(({ data }) => {
        const photo = photoFor(data.photo);
        return (
          <li class="lift grid grid-cols-[72px_1fr] items-start gap-4 rounded-[14px] border border-line bg-white p-6">
            {photo ? (
              <Picture src={photo} formats={['avif', 'webp']} widths={[72, 144, 216]} sizes="72px" alt={`Fotografia de ${data.name}`} class="size-[72px] rounded-full object-cover" />
            ) : (
              <span class="grid size-[72px] place-items-center rounded-full border-[1.5px] border-dashed border-[#9db5af] bg-soft font-display font-bold text-brand" aria-hidden="true">{data.initials}</span>
            )}
            <div class="grid gap-1.5">
              <h3 class="text-[1.15rem]">{data.name}</h3>
              <p class="text-muted">{data.bio}</p>
            </div>
          </li>
        );
      })}
    </ul>
    {head.quote && (
      <blockquote class="mt-7 max-w-[46ch] border-l-[3px] border-brand py-1 pl-6 font-display text-[clamp(1.25rem,2.6vw,1.6rem)] leading-[1.35] font-semibold tracking-[-0.01em]">
        <p>“{head.quote}”</p>
      </blockquote>
    )}
  </div>
</section>
