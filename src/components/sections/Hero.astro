---
import Icon from '../ui/Icon.astro';
import HeroPhone from '../mockups/HeroPhone.astro';
import WhatsAppIcon from '../ui/WhatsAppIcon.astro';
import { getSection, getSettings, whatsappHref, bookingHref, isExternal } from '../../lib/site';

const hero = await getSection('hero');
const s = await getSettings();
const wa = whatsappHref(s.contacts.whatsapp, s.whatsappMessage);
const booking = bookingHref(s.contacts.whatsapp, s.whatsappMessage);
const ext = (href: string) => (isExternal(href) ? { target: '_blank', rel: 'noopener' } : {});
---
<section class="on-dark relative isolate overflow-hidden bg-ink text-white" aria-labelledby="hero-title">
  <!-- Fundo animado: rede de partículas já recolorida para as cores do site (fundo = ink, linhas = aqua).
       Sem JavaScript ou com "reduzir movimento", fica só o poster. -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <video
      data-hero-video
      class="size-full object-cover opacity-60"
      poster="/video/hero-poster.jpg"
      muted
      loop
      playsinline
      preload="none"
      disablepictureinpicture
    >
      <source src="/video/hero.webm" type="video/webm" />
      <source src="/video/hero.mp4" type="video/mp4" />
    </video>
    <!-- Mais escuro à esquerda (texto) e em baixo, para manter o contraste. -->
    <div class="absolute inset-0 bg-[linear-gradient(90deg,var(--color-ink)_0%,color-mix(in_srgb,var(--color-ink)_70%,transparent)_45%,transparent_100%)]"></div>
    <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-ink to-transparent"></div>
  </div>
  <div class="container-site grid items-center gap-10 pt-10 pb-16 lg:gap-12 md:pt-14 lg:grid-cols-[1.15fr_0.85fr] lg:pb-24">
    <div class="grid max-w-[36rem] gap-6">
      <h1 id="hero-title" class="text-[clamp(2.4rem,5.6vw,4rem)] leading-[1.12] text-white">
        {hero.title} <span class="text-aqua">{hero.titleAccent}</span>
      </h1>
      <p class="max-w-[54ch] text-[1.15rem] text-on-dark">{hero.lead}</p>
      <div class="flex flex-wrap gap-3">
        <a href={wa} class="btn btn-primary w-full sm:w-auto" {...ext(wa)}><WhatsAppIcon />Falar no WhatsApp</a>
        <a href={booking} class="btn w-full border-white/55 text-white hover:border-aqua hover:text-aqua sm:w-auto" {...ext(booking)}>Marcar uma conversa</a>
      </div>
      {hero.highlights && (
        <ul class="flex flex-wrap gap-x-6 gap-y-2.5 border-t border-[#2a3f3b] pt-5 text-[0.92rem]">
          {hero.highlights.map((h) => <li class="inline-flex items-center gap-2"><Icon name="ok" class="size-[18px] text-aqua" strokeWidth={2.4} />{h}</li>)}
        </ul>
      )}
    </div>

    <!-- Fase 3: os 4 ecrãs passam em ciclo. -->
    <HeroPhone />
  </div>
</section>

<script>
  // Só arranca o vídeo se o utilizador não pediu menos movimento; pára quando o hero sai do ecrã.
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (video && !motion.matches) {
    const play = () => video.play().catch(() => {});
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => (entry.isIntersecting ? play() : video.pause())).observe(video);
    } else {
      play();
    }
    motion.addEventListener('change', (e) => e.matches && video.pause());
  }
</script>
