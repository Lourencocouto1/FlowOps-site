---
// Forma principal do símbolo (o "F"), como elemento gráfico: marca de água, fundo do hero. Cor via currentColor.
// Vem de public/brand/mark.svg, gerado por scripts/build-brand.mjs a partir de public/brand/logo-source.svg.
import mark from '../../../public/brand/mark.svg?raw';

interface Props { class?: string }
const { class: className = '' } = Astro.props;
const svg = mark
  .replace(/<title[^>]*>.*?<\/title>/, '')
  .replace(/ role="img" aria-labelledby="t"/, ` class="${className}" aria-hidden="true" focusable="false"`);
---
<Fragment set:html={svg} />
