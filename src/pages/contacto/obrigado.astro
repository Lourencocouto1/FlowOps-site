---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Mensagem enviada" minimal noindex>
  <section class="container-site grid max-w-[640px] justify-items-start gap-5 py-24">
    <p class="eyebrow">Contacto</p>
    <h1 class="text-[clamp(2rem,4vw,2.75rem)]">Obrigado. Recebemos a sua mensagem.</h1>
    <p class="text-muted">Vamos ler o seu pedido e responder pessoalmente, normalmente até 1 dia útil.</p>
    <a href="/" class="btn btn-primary">Voltar ao início</a>
  </section>
</BaseLayout>
