{
  // Configuração do Worker da Cloudflare. O Astro preenche "main" e "assets" no build.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flowops-site",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Limite de pedidos do formulário: 5 por minuto por IP (o período tem de ser 10 ou 60 segundos).
  "ratelimits": [
    { "name": "CONTACT_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ]
}
