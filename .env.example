# Copiar para .env e preencher. Nunca commitar o ficheiro .env.

# URL público do site (usado no sitemap, canonical e Open Graph). [A CONFIRMAR: domínio]
PUBLIC_SITE_URL=https://flowops.pt

# Plataforma de marcações (projeto separado). Se ficar vazio, "Marcar uma conversa" abre o WhatsApp
# com a mensagem "Olá! Vi o site da FlowOps e gostava de saber mais."
PUBLIC_BOOKING_URL=

# Mostrar a secção de preços (true/false). Escondida por defeito.
PUBLIC_SHOW_PRICING=false

# --- Formulário de contacto (/api/contact) · configurado na fase 4 ---
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=
# PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
