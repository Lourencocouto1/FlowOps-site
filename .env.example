# Copiar para .env e preencher. Nunca commitar o ficheiro .env.
# Em produção, definir estes valores no painel da Cloudflare (Workers > Settings > Variables and Secrets).

# URL público do site (canonical, sitemap, Open Graph). [A CONFIRMAR: domínio]
PUBLIC_SITE_URL=https://flowops.pt

# Plataforma de marcações (projeto separado). Vazio: "Marcar uma conversa" abre o WhatsApp
# com a mensagem "Olá! Vi o site da FlowOps e gostava de saber mais."
PUBLIC_BOOKING_URL=

# Mostrar a secção de preços (true/false). Escondida por defeito.
PUBLIC_SHOW_PRICING=false

# --- Formulário de contacto (/api/contact) ---
# Cloudflare Turnstile. Estas são as CHAVES DE TESTE oficiais (passam sempre). Substituir pelas reais.
#   Teste que falha sempre: segredo 2x0000000000000000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Resend (envio do email). Sem chave, o formulário só funciona em modo simulado.
RESEND_API_KEY=
# Para onde vão os pedidos e de que endereço saem (o domínio do remetente tem de estar verificado no Resend).
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="FlowOps <site@flowops.pt>"

# Envio simulado: valida tudo, regista no log e responde como se tivesse enviado. Usar só em testes.
CONTACT_DRY_RUN=true
